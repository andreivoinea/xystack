diff --git a/src/services/refunds.ts b/src/services/refunds.ts
new file mode 100644
index 0000000..70d6908
--- /dev/null
+++ b/src/services/refunds.ts
@@ -0,0 +1,22 @@
+import * as db from "../db.ts";
+import { errorResponse } from "../handlers/errors.ts";
+import type { Response } from "../http.ts";
+import { toCents } from "../money.ts";
+import { getOrderForUser } from "./orders.ts";
+
+/** Refunds part or all of the user's paid order and returns the HTTP response. */
+export function refundOrder(orderId: string, userId: string, amount: string): Response {
+  try {
+    const order = getOrderForUser(orderId, userId);
+    if (order.status !== "paid") return { status: 400, body: { error: "only paid orders can be refunded" } };
+    const amountCents = toCents(amount);
+    if (amountCents <= 0) return { status: 400, body: { error: "invalid amount" } };
+    if (amountCents > order.totalCents) return { status: 400, body: { error: "refund exceeds order total" } };
+
+    db.insertRefund({ orderId: order.id, amountCents, createdAt: new Date().toISOString() });
+    db.updateOrder({ ...order, status: "refunded" });
+    return { status: 200, body: { refunded: amountCents } };
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
