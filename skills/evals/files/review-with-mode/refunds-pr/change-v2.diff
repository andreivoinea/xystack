 });
+
+test("users can't refund other users' orders", () => {
+  seedOrder({ status: "paid" });
+  assert.equal(handleRefund(request({ userId: "mallory", params: { id: "o1" }, body: { amount: "1" } })).status, 404);
+  assert.deepEqual(db.listRefunds("o1"), []);
+});
+
+test("rounds half a cent up", () => {
+  seedOrder({ status: "paid" });
+  handleRefund(request({ params: { id: "o1" }, body: { amount: "0.285" } }));
+  assert.deepEqual(db.listRefunds("o1").map((refund) => refund.amountCents), [29]);
+});
