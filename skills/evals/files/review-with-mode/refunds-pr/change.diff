--- /dev/null
+++ b/test/refunds.test.ts
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { beforeEach, test } from "node:test";
+import * as db from "../src/db.ts";
+import { handleRefund } from "../src/handlers/refunds.ts";
+import { request, seedOrder } from "./helpers.ts";
+
+beforeEach(() => db.reset());
+
+test("refunds a paid order", () => {
+  seedOrder({ status: "paid" });
+  const response = handleRefund(request({ params: { id: "o1" }, body: { amount: "20" } }));
+  assert.equal(response.status, 200);
+  assert.deepEqual(db.listRefunds("o1").map((refund) => refund.amountCents), [2000]);
+});
+
+test("rejects refunds above the order total", () => {
+  seedOrder({ status: "paid" });
+  assert.equal(handleRefund(request({ params: { id: "o1" }, body: { amount: "50.01" } })).status, 400);
+});
+
+test("rejects refunds for unpaid orders", () => {
+  seedOrder();
+  assert.equal(handleRefund(request({ params: { id: "o1" }, body: { amount: "1" } })).status, 400);
+});
