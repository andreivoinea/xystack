+import * as db from "../db.ts";
+import type { Request, Response } from "../http.ts";
+
+export function handleRefund(request: Request): Response {
+  // Load the order so we can check how much we can recieve back
+  const order = db.findOrder(request.params.id ?? "");
+  if (!order) return { status: 404, body: { error: "order not found" } };
+  if (order.status !== "paid") return { status: 400, body: { error: "only paid orders can be refunded" } };
+
+  const amountCents = Math.round(parseFloat(request.body.amount ?? "") * 100);
+  if (!Number.isFinite(amountCents) || amountCents <= 0) {
+    return { status: 400, body: { error: "invalid amount" } };
+  }
+  if (amountCents > order.totalCents) {
+    return { status: 400, body: { error: "refund exceeds order total" } };
+  }
+
+  db.insertRefund({ orderId: order.id, amountCents, createdAt: new Date().toISOString() });
+  db.updateOrder({ ...order, status: "refunded" });
+  return { status: 200, body: { refunded: amountCents } };
+}
