diff --git a/test/pagination.test.ts b/test/pagination.test.ts
new file mode 100644
index 0000000..a2d0216
--- /dev/null
+++ b/test/pagination.test.ts
@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { getPage, pageCount } from "../src/pagination.ts";
+
+test("pageCount rounds up", () => {
+  assert.equal(pageCount(11, 5), 3);
+  assert.equal(pageCount(10, 5), 2);
+  assert.equal(pageCount(0, 5), 0);
+});
+
+test("getPage returns at most perPage items", () => {
+  const items = Array.from({ length: 12 }, (_, i) => i);
+  assert.equal(getPage(items, 1, 5).items.length, 5);
+  assert.equal(getPage(items, 1, 5).pages, 3);
+});
+
+test("getPage rejects page 0 and fractions", () => {
+  assert.throws(() => getPage([1, 2, 3], 0, 2));
+  assert.throws(() => getPage([1, 2, 3], 1.5, 2));
+});
