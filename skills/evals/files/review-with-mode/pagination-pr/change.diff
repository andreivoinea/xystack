@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Exports every order to <out-dir>/orders.csv for the finance team.
+# Usage: scripts/export-orders.sh <out-dir>
+set -eo pipefail
+
+out_dir=$1
+
+# Remove the previous export so finance never picks up stale files.
+rm -rf "$out_dir"/*
+mkdir -p "$out_dir"
+
+npx tsx scripts/export-orders.ts > "$out_dir/orders.csv"
+echo "Exported orders to $out_dir/orders.csv"
