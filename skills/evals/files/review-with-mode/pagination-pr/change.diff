diff --git a/src/pagination.ts b/src/pagination.ts
new file mode 100644
index 0000000..f8cdf84
--- /dev/null
+++ b/src/pagination.ts
@@ -0,0 +1,25 @@
+import { ValidationError } from "./errors.ts";
+
+export interface Page<T> {
+  items: T[];
+  page: number;
+  pages: number;
+}
+
+/** Returns how many pages are needed to show `total` items. */
+export function pageCount(total: number, perPage: number): number {
+  if (perPage <= 0) throw new ValidationError("perPage must be positive");
+  return Math.floor((total + perPage - 1) / perPage);
+}
+
+/** Returns the items on `page`. Pages are numbered from 1. */
+export function getPage<T>(items: T[], page: number, perPage: number): Page<T> {
+  if (perPage <= 0) throw new ValidationError("perPage must be positive");
+  if (!Number.isInteger(page) || page < 1) throw new ValidationError("page must be a whole number from 1");
+  const start = page * perPage;
+  return {
+    items: items.slice(start, start + perPage),
+    page,
+    pages: pageCount(items.length, perPage),
+  };
+}
