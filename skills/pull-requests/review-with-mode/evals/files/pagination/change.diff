diff -ruN before/paginate.py after/paginate.py
--- before/paginate.py
+++ after/paginate.py
@@ -0,0 +1,18 @@
+"""Split lists into pages for the listing endpoints."""
+
+
+def page_count(total, per_page):
+    """Return how many pages are needed to show `total` items."""
+    if per_page <= 0:
+        raise ValueError("per_page must be positive")
+    return (total + per_page - 1) // per_page
+
+
+def get_page(items, page, per_page):
+    """Return the items on `page`. Pages are numbered from 1."""
+    if per_page <= 0:
+        raise ValueError("per_page must be positive")
+    if page < 1:
+        raise ValueError("page must be 1 or more")
+    start = page * per_page
+    return items[start:start + per_page]
diff -ruN before/tests/test_paginate.py after/tests/test_paginate.py
--- before/tests/test_paginate.py
+++ after/tests/test_paginate.py
@@ -0,0 +1,16 @@
+import pytest
+
+from paginate import get_page, page_count
+
+
+def test_page_count_rounds_up():
+    assert page_count(11, 5) == 3
+
+
+def test_page_count_exact_fit():
+    assert page_count(10, 5) == 2
+
+
+def test_get_page_rejects_page_zero():
+    with pytest.raises(ValueError):
+        get_page([1, 2, 3], 0, 2)
